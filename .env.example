# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Project URL from Supabase Settings > API
SUPABASE_URL=https://your-project-id.supabase.co

# Secret / service role key. Server-side Python loaders only. Never put this in HTML or JS.
SUPABASE_KEY=

# Publishable (or legacy anon) key. Safe to inject into Flask and the React app.
SUPABASE_PUBLISHABLE_KEY=

# Vite only exposes VITE_ variables to the React app. Copy the same values as above.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
